# Slack app-level token (xapp-…). Basic Information → App-Level Tokens →
# generate a token with the connections:write scope (required for Socket Mode).
SLACK_APP_TOKEN=xapp-...

# Bot user OAuth token (xoxb-…). Install App → Bot User OAuth Token.
SLACK_BOT_TOKEN=xoxb-...

# REQUIRED. Comma-separated Slack member IDs allowed to use the bridge
# (Slack profile → three-dot menu → Copy member ID). Everyone else is ignored.
SLACK_ALLOWED_USERS=U012ABCDEF

# omp binary to invoke (name on PATH or absolute path).
OMP_BIN=omp

# Comma-separated alias=path repo map. Aliases are what you type in Slack:
# `run <alias> <prompt>`. Paths may use ~.
REPOS=omp=~/oh-my-pi-src

# Alias used when `run <prompt>` omits the repo.
DEFAULT_REPO=omp

# Max concurrently running omp tasks.
MAX_TASKS=4

# Minutes an idle RPC session is kept alive before being reaped.
IDLE_TTL_MIN=30

# Prefix for omp session names created by the bridge.
SESSION_NAME_PREFIX=slack:

# How far back the startup/periodic catch-up sweep may reach for DMs missed
# while the socket was down (minutes). 0 disables catch-up entirely.
CATCHUP_WINDOW_MIN=60

# pi model spec for the front-door router (e.g. shuttle/gemma-4-26b, served by
# Shuttle on 127.0.0.1:8780). Empty disables the router: every message goes
# straight to the literal first-token parser.
ROUTER_MODEL=

# Per-message routing deadline in milliseconds; on elapse the router fails open.
ROUTER_TIMEOUT_MS=60000

# Override the path to route.sh. Empty uses the router/route.sh shipped beside
# the installed bridge.
ROUTER_SCRIPT=

# Model the `orchestrate` command spawns omp with. Empty resolves it from the
# `orchestrate` agent definition (fallback anthropic/claude-fable-5).
ORCHESTRATE_MODEL=
