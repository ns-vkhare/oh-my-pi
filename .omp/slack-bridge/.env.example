# Slack app-level token (xapp-…). Basic Information → App-Level Tokens →
# generate a token with the connections:write scope (required for Socket Mode).
SLACK_APP_TOKEN=xapp-...

# Bot user OAuth token (xoxb-…). Install App → Bot User OAuth Token.
SLACK_BOT_TOKEN=xoxb-...

# REQUIRED. Comma-separated Slack member IDs allowed to use the bridge
# (Slack profile → three-dot menu → Copy member ID). Everyone else is ignored.
SLACK_ALLOWED_USERS=U012ABCDEF

# omp binary to invoke (name on PATH or absolute path).
OMP_BIN=omp

# Comma-separated alias=path repo map. Aliases are what you type in Slack:
# `run <alias> <prompt>`. Paths may use ~.
REPOS=omp=~/oh-my-pi-src

# Alias used when `run <prompt>` omits the repo.
DEFAULT_REPO=omp

# Max concurrently running omp tasks.
MAX_TASKS=4

# Minutes an idle RPC session is kept alive before being reaped.
IDLE_TTL_MIN=30

# Prefix for omp session names created by the bridge.
SESSION_NAME_PREFIX=slack:
